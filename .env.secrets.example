# Copy to .env.secrets (gitignored), fill in, then run: ./scripts/set-secrets.sh
# Leave a line blank to skip it. Never commit the filled-in file.

# --- Supabase Edge Function secrets (server-only) ---
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → endpoint
#   https://ohfjvvllqlkbxduslypl.supabase.co/functions/v1/stripeWebhook
#   events: payment_intent.succeeded, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Vercel (public, ends up in the browser bundle) ---
# Must come from the SAME Stripe account as STRIPE_SECRET_KEY.
VITE_STRIPE_PUBLISHABLE_KEY=
